{
  "name": "ya-nr-sim",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "build:ci": "concurrently \"npm:lint:fix\" \"npm:typecheck\" \"npm:test:run\" && npm run build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage:run": "npm run test:run -- --coverage",
    "bench": "vitest bench",
    "bench:run": "vitest bench --run",
    "generate:relic-data": "tsx scripts/generate-relic-data.ts"
  },
  "dependencies": {
    "@conform-to/react": "^1.21.3",
    "@conform-to/valibot": "^1.21.3",
    "@react-router/fs-routes": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "comlink": "^4.4.2",
    "es-toolkit": "^1.39.10",
    "isbot": "^5.1.30",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.2",
    "tslib": "^2.9.1",
    "valibot": "^1.1.0",
    "yalps": "^0.5.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.3",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.5.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "isbot": "^5.1.30",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "type-fest": "^6.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
